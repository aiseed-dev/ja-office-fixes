             this.cmbLigatures.on('selected', _.bind(this.onLigaturesSelect, this));
 
+            // The East Asian and Latin fonts of the text, as in Word's font dialog
+            var createFontCombo = function(el, put) {
+                return new Common.UI.ComboBoxFonts({
+                    el          : $(el),
+                    cls         : 'input-group-nr',
