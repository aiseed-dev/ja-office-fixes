@@ -123,6 +123,18 @@
 </div>
 <div id="id-adv-paragraph-font" class="settings-panel">
     <div class="inner-content" style="width: 100%;">
+        <table cols="2" role="presentation">
+            <tr>
+                <td class="padding-large">
+                    <label class="input-label"><%= scope.textEastAsiaFont %></label>
+                    <div id="paragraphadv-cmb-font-eastasia"></div>
