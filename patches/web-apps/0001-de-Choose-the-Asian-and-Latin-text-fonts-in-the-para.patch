From e1ed2e4fea1f8dafa581bfa40fad40704b49233d Mon Sep 17 00:00:00 2001
From: ja-office-fixes <ja-office-fixes@localhost>
Date: Sun, 11 Oct 2026 06:29:04 +0900
Subject: [PATCH] [de] Choose the Asian and Latin text fonts in the paragraph
 dialog

Word's font dialog has a font for Asian text (w:eastAsia) and one for
Latin text (w:ascii, w:hAnsi). The Font tab of the paragraph advanced
settings now has both, filled from the selection and empty when it has
more than one font. Each changes only its own text. The font list is
the toolbar's, which the toolbar controller now hands out with
getFontStore().
---
 .../main/app/controller/DocumentHolderExt.js  |  1 +
 .../main/app/controller/Toolbar.js            | 23 ++++++----
 .../ParagraphSettingsAdvanced.template        | 12 +++++
 .../main/app/view/ParagraphSettings.js        |  1 +
 .../app/view/ParagraphSettingsAdvanced.js     | 44 +++++++++++++++++--
 apps/documenteditor/main/locale/en.json       |  2 +
 apps/documenteditor/main/locale/ja.json       |  2 +
 7 files changed, 74 insertions(+), 11 deletions(-)

diff --git a/apps/documenteditor/main/app/controller/DocumentHolderExt.js b/apps/documenteditor/main/app/controller/DocumentHolderExt.js
index beb1e836..41cd630f 100644
--- a/apps/documenteditor/main/app/controller/DocumentHolderExt.js
+++ b/apps/documenteditor/main/app/controller/DocumentHolderExt.js
@@ -2134,6 +2134,7 @@ define([], function () {
                                 tableStylerRows     : 2,
                                 tableStylerColumns  : 1,
                                 paragraphProps      : elValue,
+                                fontStore           : me.getApplication().getController('Toolbar').getFontStore(),
                                 borderProps         : me.borderAdvancedProps,
                                 isChart             : (item.isChart===true),
                                 isSmartArtInternal  : (item.isSmartArtInternal===true),
diff --git a/apps/documenteditor/main/app/controller/Toolbar.js b/apps/documenteditor/main/app/controller/Toolbar.js
index 308164da..21abacfc 100644
--- a/apps/documenteditor/main/app/controller/Toolbar.js
+++ b/apps/documenteditor/main/app/controller/Toolbar.js
@@ -2361,21 +2361,28 @@ define([
             this._state.dropcap = v;
         },
 
-        onDropCapAdvancedClick: function(isFrame) {
-            var win, props, text,
-                me = this;
-
-            if (!isFrame && _.isUndefined(me.fontstore)) {
-                me.fontstore = new Common.Collections.Fonts();
-                var fonts = me.toolbar.cmbFontName.store.toJSON();
+        // The fonts of the toolbar's font list, for the dialogs that choose a font
+        getFontStore: function() {
+            if (_.isUndefined(this.fontstore)) {
+                this.fontstore = new Common.Collections.Fonts();
+                var fonts = this.toolbar.cmbFontName.store.toJSON();
                 var arr = [];
                 _.each(fonts, function(font, index){
                     if (!font.cloneid) {
                         arr.push(_.clone(font));
                     }
                 });
-                me.fontstore.add(arr);
+                this.fontstore.add(arr);
             }
+            return this.fontstore;
+        },
+
+        onDropCapAdvancedClick: function(isFrame) {
+            var win, props, text,
+                me = this;
+
+            if (!isFrame)
+                me.getFontStore();
 
             if (me.api){
                 var selectedElements = me.api.getSelectedElements(),
