+                <td class="padding-large padding-left-10">
+                    <label class="input-label"><%= scope.textAsciiFont %></label>
+                    <div id="paragraphadv-cmb-font-ascii"></div>
+                </td>
+            </tr>
+        </table>
         <div class="padding-very-small">
             <label class="header"><%= scope.textEffects %></label>
         </div>
