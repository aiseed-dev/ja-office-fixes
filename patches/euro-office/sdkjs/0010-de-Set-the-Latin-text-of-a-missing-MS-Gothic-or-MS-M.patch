+$(function () {
+
+	QUnit.module("Latin fonts of a missing font");
+
+	// Pretend which fonts are installed, then put the list back
+	function withFonts(names, f)
+	{
+		let saved = AscFonts.g_map_font_index;
+		AscFonts.g_map_font_index = {};
+		names.forEach(function (name, i) { AscFonts.g_map_font_index[name] = i; });
+		try { f(); } finally { AscFonts.g_map_font_index = saved; }
+	}
+
+	QUnit.test("MS Gothic and MS Mincho take BIZ UD for Latin text", function (assert)
+	{
+		withFonts(["BIZ UDGothic", "BIZ UDMincho"], function ()
+		{
+			assert.strictEqual(AscFonts.getLatinFontName("ＭＳ ゴシック"), "BIZ UDGothic", "ＭＳ ゴシック");
+			assert.strictEqual(AscFonts.getLatinFontName("MS Gothic"), "BIZ UDGothic", "MS Gothic");
+			assert.strictEqual(AscFonts.getLatinFontName("ＭＳ 明朝"), "BIZ UDMincho", "ＭＳ 明朝");
+			assert.strictEqual(AscFonts.getLatinFontName("MS Mincho"), "BIZ UDMincho", "MS Mincho");
+			// Proportional fonts have other widths, so they are not replaced
+			assert.strictEqual(AscFonts.getLatinFontName("ＭＳ Ｐゴシック"), "ＭＳ Ｐゴシック", "ＭＳ Ｐゴシック");
+			assert.strictEqual(AscFonts.getLatinFontName("Arial"), "Arial", "Arial");
+		});
+		withFonts(["MS Gothic", "BIZ UDGothic"], function ()
+		{
+			assert.strictEqual(AscFonts.getLatinFontName("MS Gothic"), "MS Gothic", "installed");
+		});
+		withFonts([], function ()
+		{
+			assert.strictEqual(AscFonts.getLatinFontName("MS Gothic"), "MS Gothic", "no BIZ UD");
+		});
+	});
+
+	QUnit.test("Only the Latin slots of a run take the replacement", function (assert)
+	{
+		withFonts(["BIZ UDGothic"], function ()
+		{
+			let textPr = new CTextPr();
+			textPr.InitDefault();
+			textPr.RFonts.SetAll("ＭＳ ゴシック", -1);
+			assert.strictEqual(textPr.GetFontInfo(AscWord.fontslot_ASCII).Name, "BIZ UDGothic", "ASCII");
+			assert.strictEqual(textPr.GetFontInfo(AscWord.fontslot_HAnsi).Name, "BIZ UDGothic", "HAnsi");
+			assert.strictEqual(textPr.GetFontInfo(AscWord.fontslot_EastAsia).Name, "ＭＳ ゴシック", "East Asian");
+			assert.strictEqual(textPr.RFonts.Ascii.Name, "ＭＳ ゴシック", "the name kept");
+		});
+	});
+});
