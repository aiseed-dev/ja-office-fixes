diff --git a/common/libfont/map.js b/common/libfont/map.js
index 58cd001..d90cdef 100644
--- a/common/libfont/map.js
+++ b/common/libfont/map.js
@@ -3095,6 +3095,28 @@
 
 	var g_fontApplication = new CApplicationFonts();
 
+	// The font for the Latin text of a font that is not installed. MS Gothic
+	// and MS Mincho give every Latin letter half the width of a kanji, and
+	// the font picked for them otherwise (Arial Unicode MS on a Mac) does not,
+	// so lines would break elsewhere than in Word. BIZ UDGothic and
+	// BIZ UDMincho have the same widths for every letter, kana and kanji.
+	// Their East Asian text keeps the font picked as before
+	var g_latinReplacements = {
+		"MS Gothic"   : "BIZ UDGothic",
+		"ＭＳ ゴシック" : "BIZ UDGothic",
+		"MS Mincho"   : "BIZ UDMincho",
+		"ＭＳ 明朝"     : "BIZ UDMincho"
+	};
+	function getLatinFontName(name)
+	{
+		var replacement = g_latinReplacements[name];
+		if (!replacement
+			|| undefined !== AscFonts.g_map_font_index[name]
+			|| undefined === AscFonts.g_map_font_index[replacement])
+			return name;
+		return replacement;
+	}
+
 	//------------------------------------------------------export------------------------------------------------------
 	window['AscFonts'] = window['AscFonts'] || {};
 	window['AscFonts'].FontStyle = FontStyle;
@@ -3104,6 +3126,7 @@
 	window['AscFonts'].LanguagesFontSelectTypes = LanguagesFontSelectTypes;
 
 	window['AscFonts'].g_fontApplication = g_fontApplication;
+	window['AscFonts'].getLatinFontName = getLatinFontName;
 
 	window['AscFonts']['pickFont'] = function(name, style) {
 		var info = AscFonts.g_fontApplication.GetFontInfo(name, style);
