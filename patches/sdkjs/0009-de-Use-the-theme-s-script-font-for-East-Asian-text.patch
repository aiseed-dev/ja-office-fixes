From 1c02226230c492a0cb01b4ab6794f92b605949c9 Mon Sep 17 00:00:00 2001
From: ja-office-fixes <ja-office-fixes@localhost>
Date: Sat, 10 Oct 2026 22:11:55 +0900
Subject: [PATCH] [de] Use the theme's script font for East Asian text

A theme lists a font for each script (a:font, ECMA-376 20.1.4.1.16),
and Office themes leave a:ea empty and name the Japanese font in
<a:font script="Jpan">. The list was skipped when the theme was read,
so minorEastAsia fell back to the Latin font and Japanese text was
drawn in a Chinese face.

Word picks the script by w:themeFontLang (17.15.1.88). The binary has
no such setting, so the East Asian language of the text (w:lang
eastAsia) stands in for it. The list is also written back on save.
---
 common/Drawings/Format/Format.js  |  43 +++++++++++-
 common/Shapes/Serialize.js        |  41 ++++++++++-
 common/Shapes/SerializeWriter.js  |   9 +++
 tests/word/styles/themeFonts.html |  36 ++++++++++
 tests/word/styles/themeFonts.js   | 111 ++++++++++++++++++++++++++++++
 word/Editor/Styles.js             |   5 +-
 6 files changed, 239 insertions(+), 6 deletions(-)
 create mode 100644 tests/word/styles/themeFonts.html
 create mode 100644 tests/word/styles/themeFonts.js

diff --git a/common/Drawings/Format/Format.js b/common/Drawings/Format/Format.js
index 5048011..bde23e4 100644
--- a/common/Drawings/Format/Format.js
+++ b/common/Drawings/Format/Format.js
@@ -9980,6 +9980,8 @@
 			this.latin = null;
 			this.ea = null;
 			this.cs = null;
+			// The script fonts (a:font, ECMA-376 20.1.4.1.16) as {script, typeface}
+			this.fonts = [];
 			if (fontScheme) {
 				this.setFontScheme(fontScheme);
 			}
@@ -10006,6 +10008,16 @@
 			if (this.fontScheme)
 				this.fontScheme.checkFromFontCollection(pr, this, FONT_REGION_CS);
 		};
+		FontCollection.prototype.addFont = function (script, typeface) {
+			this.fonts.push({script: script, typeface: typeface});
+		};
+		FontCollection.prototype.getFont = function (script) {
+			for (var i = 0; i < this.fonts.length; ++i) {
+				if (this.fonts[i].script === script)
+					return this.fonts[i].typeface;
+			}
+			return null;
+		};
 		FontCollection.prototype.Write_ToBinary = function (w) {
 			writeString(w, this.latin);
 			writeString(w, this.ea);
@@ -10065,6 +10077,8 @@
 			oCopy.minorFont.setLatin(this.minorFont.latin);
 			oCopy.minorFont.setEA(this.minorFont.ea);
 			oCopy.minorFont.setCS(this.minorFont.cs);
+			oCopy.majorFont.fonts = this.majorFont.fonts.slice();
+			oCopy.minorFont.fonts = this.minorFont.fonts.slice();
 			return oCopy;
 		};
 		FontScheme.prototype.Refresh_RecalcData = function () {
@@ -10120,9 +10134,34 @@
 				}
 			}
 		};
-		FontScheme.prototype.checkFont = function (font) {
+		// The ISO 15924 script of the theme fonts for an East Asian language
+		// (an LCID), as Word picks them by w:themeFontLang (ECMA-376 17.15.1.88)
+		function getEastAsianScript(lcid) {
+			switch (lcid & 0x3FF) {
+				case 0x11: return "Jpan";
+				case 0x12: return "Hang";
+				case 0x04: return (0x0404 === lcid || 0x0C04 === lcid || 0x1404 === lcid) ? "Hant" : "Hans";
+			}
+			return null;
+		}
+		FontScheme.prototype.getEastAsianFont = function (font, lcid) {
+			var script = lcid ? getEastAsianScript(lcid) : null;
+			if (!script)
+				return null;
+			if ("+mn-ea" === font || "minorEastAsia" === font)
+				return this.minorFont.getFont(script);
+			if ("+mj-ea" === font || "majorEastAsia" === font)
+				return this.majorFont.getFont(script);
+			return null;
+		};
+		// eastAsiaLcid: the East Asian language of the text. The binary has no
+		// w:themeFontLang, so the language of the text stands in for it
+		FontScheme.prototype.checkFont = function (font, eastAsiaLcid) {
 			if (g_oThemeFontsName[font]) {
-				if (this.fontMap[font]) {
+				var scriptFont = this.getEastAsianFont(font, eastAsiaLcid);
+				if (scriptFont) {
+					return scriptFont;
+				} else if (this.fontMap[font]) {
 					return this.fontMap[font];
 				} else if (this.fontMap["+mn-lt"]) {
 					return this.fontMap["+mn-lt"];
diff --git a/common/Shapes/Serialize.js b/common/Shapes/Serialize.js
index f8a03c5..831d1fc 100644
--- a/common/Shapes/Serialize.js
+++ b/common/Shapes/Serialize.js
@@ -5276,8 +5276,13 @@ function BinaryPPTYLoader()
                 }
                 case 3:
                 {
-                    var _len = s.GetULong();
-                    s.Skip2(_len);
+                    s.Skip2(4); // len
+                    var _c = s.GetULong();
+                    for (var i = 0; i < _c; i++)
+                    {
+                        s.Skip2(1); // type
+                        this.ReadSupplementalFont(fontcolls);
+                    }
                     break;
                 }
                 default:
@@ -5291,6 +5296,38 @@ function BinaryPPTYLoader()
         s.Seek2(_end_rec);
     };
 
+    this.ReadSupplementalFont = function(fontcolls)
+    {
+        var s = this.stream;
+
+        var _rec_start = s.cur;
+        var _end_rec = _rec_start + s.GetULong() + 4;
+
+        var script = "";
+        var typeface = "";
+
+        s.Skip2(1); // start attributes
+
+        while (true)
+        {
+            var _at = s.GetUChar();
+            if (_at == g_nodeAttributeEnd)
+                break;
+
+            if (0 == _at)
+                script = s.GetString2();
+            else if (1 == _at)
+                typeface = s.GetString2();
+            else
+                break;
+        }
+
+        if (script)
+            fontcolls.addFont(script, typeface);
+
+        s.Seek2(_end_rec);
+    };
+
     this.ReadTextFontTypeface = function()
     {
         var s = this.stream;
diff --git a/common/Shapes/SerializeWriter.js b/common/Shapes/SerializeWriter.js
index bd0100a..29f0589 100644
--- a/common/Shapes/SerializeWriter.js
+++ b/common/Shapes/SerializeWriter.js
@@ -1628,6 +1628,15 @@ function CBinaryFileWriter()
         oThis.WriteRecord1(0, { Name: coll.latin, Index : -1 }, oThis.WriteTextFontTypeface);
         oThis.WriteRecord1(1, { Name: coll.ea, Index : -1 }, oThis.WriteTextFontTypeface);
         oThis.WriteRecord1(2, { Name: coll.cs, Index : -1 }, oThis.WriteTextFontTypeface);
+        if (coll.fonts && coll.fonts.length > 0)
+            oThis.WriteRecordArray(3, 0, coll.fonts, oThis.WriteSupplementalFont);
+    };
+    this.WriteSupplementalFont = function(font)
+    {
+        oThis.WriteUChar(g_nodeAttributeStart);
+        oThis._WriteString1(0, font.script);
+        oThis._WriteString1(1, font.typeface);
+        oThis.WriteUChar(g_nodeAttributeEnd);
     };
     this.WriteFmtScheme = function(fmt)
     {
