+$(function () {
+
+	// A theme as Office writes it: a:ea is empty and the East Asian fonts
+	// are in the script list (a:font, ECMA-376 20.1.4.1.16)
+	function createFontScheme()
+	{
+		let fontScheme = new AscFormat.FontScheme();
+		fontScheme.majorFont.setLatin("Yu Gothic Light");
+		fontScheme.majorFont.setEA("");
+		fontScheme.majorFont.addFont("Jpan", "游ゴシック Light");
+		fontScheme.minorFont.setLatin("Yu Mincho");
+		fontScheme.minorFont.setEA("");
+		fontScheme.minorFont.addFont("Jpan", "游明朝");
+		fontScheme.minorFont.addFont("Hang", "맑은 고딕");
+		fontScheme.minorFont.addFont("Hans", "等线");
+		fontScheme.minorFont.addFont("Hant", "新細明體");
+		return fontScheme;
+	}
+
+	QUnit.module("Theme fonts");
+
+	QUnit.test("The script font is used for the East Asian language", function (assert)
+	{
+		let fontScheme = createFontScheme();
+		assert.strictEqual(fontScheme.checkFont("minorEastAsia", 1041), "游明朝", "ja-JP");
+		assert.strictEqual(fontScheme.checkFont("+mn-ea", 1041), "游明朝", "+mn-ea, ja-JP");
+		assert.strictEqual(fontScheme.checkFont("majorEastAsia", 1041), "游ゴシック Light", "major, ja-JP");
+		assert.strictEqual(fontScheme.checkFont("minorEastAsia", 1042), "맑은 고딕", "ko-KR");
+		assert.strictEqual(fontScheme.checkFont("minorEastAsia", 2052), "等线", "zh-CN");
+		assert.strictEqual(fontScheme.checkFont("minorEastAsia", 4100), "等线", "zh-SG");
+		assert.strictEqual(fontScheme.checkFont("minorEastAsia", 1028), "新細明體", "zh-TW");
+		assert.strictEqual(fontScheme.checkFont("minorEastAsia", 3076), "新細明體", "zh-HK");
+
+		// No language, a language without a script font, or a script the
+		// theme does not list: as before
+		assert.strictEqual(fontScheme.checkFont("minorEastAsia"), "Yu Mincho", "no language");
+		assert.strictEqual(fontScheme.checkFont("minorEastAsia", 1033), "Yu Mincho", "en-US");
+		// (an empty theme font falls back to the minor Latin font)
+		assert.strictEqual(fontScheme.checkFont("majorEastAsia", 1042), "Yu Mincho", "major, ko-KR");
+
+		// Only the East Asian theme fonts follow the language
+		assert.strictEqual(fontScheme.checkFont("minorHAnsi", 1041), "Yu Mincho", "minorHAnsi");
+		assert.strictEqual(fontScheme.checkFont("MS Mincho", 1041), "MS Mincho", "a font name");
+	});
+
+	QUnit.test("A run takes the East Asian theme font of its language", function (assert)
+	{
+		let fontScheme = createFontScheme();
+		let textPr = new CTextPr();
+		textPr.RFonts.SetAll("Arial", -1);
+		textPr.RFonts.AsciiTheme    = "minorHAnsi";
+		textPr.RFonts.EastAsiaTheme = "minorEastAsia";
+		textPr.Lang.EastAsia = 1041;
+		textPr.ReplaceThemeFonts(fontScheme);
+		assert.strictEqual(textPr.RFonts.EastAsia.Name, "游明朝", "East Asian font");
+		assert.strictEqual(textPr.RFonts.Ascii.Name, "Yu Mincho", "Latin font");
+	});
+
+	QUnit.test("The script fonts are kept through the binary", function (assert)
+	{
+		let fontScheme = createFontScheme();
+		let writer = new AscCommon.CBinaryFileWriter();
+		writer.WriteRecord1(0, fontScheme, writer.WriteFontScheme);
+
+		let loader = new AscCommon.BinaryPPTYLoader();
+		loader.stream = new AscCommon.FileStream(writer.data, writer.pos);
+		loader.stream.Skip2(1); // type
+		let read = new AscFormat.FontScheme();
+		loader.ReadFontScheme(read);
+		assert.deepEqual(read.minorFont.fonts, fontScheme.minorFont.fonts, "minor");
+		assert.deepEqual(read.majorFont.fonts, fontScheme.majorFont.fonts, "major");
+		assert.strictEqual(read.checkFont("minorEastAsia", 1041), "游明朝", "ja-JP after reading");
+		assert.deepEqual(fontScheme.createDuplicate().minorFont.fonts, fontScheme.minorFont.fonts, "copy");
+	});
+});
