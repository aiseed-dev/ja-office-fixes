-			this.RFonts.EastAsia.Name  = oFontScheme.checkFont(this.RFonts.EastAsia.Name);
+			this.RFonts.EastAsia.Name  = oFontScheme.checkFont(this.RFonts.EastAsia.Name, eastAsiaLcid);
 			this.RFonts.EastAsia.Index = -1;
 		}
 
