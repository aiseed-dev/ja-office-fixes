 const dBNum1Numbers = ['\u3007','\u4E00','\u4E8C','\u4E09','\u56DB','\u4E94','\u516D','\u4E03','\u516B','\u4E5D'];
+// The Japanese numerals of [DBNum1] to [DBNum3], as Excel shows them in the
+// ja-jp locale. DBNum1 writes kanji, DBNum2 the forms written on documents
+// (daiji), and DBNum3 full-width digits with the place characters of DBNum1.
+// In DBNum2 a one is written before 拾, 百 and 阡 too (壱拾); in the others it
+// is left out (十, 百五). A group of four digits is followed by 万, 億 or 兆,
+// and the digits above 兆 are written one by one.
+const dBNumJa = {
+	1: {digits: dBNum1Numbers, places: ['', '十', '百', '千'], groups: ['', '万', '億', '兆'], one: false},
+	2: {digits: ['〇', '壱', '弐', '参', '四', '伍', '六', '七', '八', '九'],
+		places: ['', '拾', '百', '阡'], groups: ['', '萬', '億', '兆'], one: true},
+	3: {digits: ['０', '１', '２', '３', '４', '５', '６', '７', '８', '９'],
+		places: ['', '十', '百', '千'], groups: ['', '万', '億', '兆'], one: false}
+};
+
+// Each digit of s replaced by its numeral, one by one
+function dBNumJaDigits(s, table) {
+	let res = '';
+	for (let i = 0; i < s.length; ++i) {
+		let c = s.charCodeAt(i) - 48;
+		res += 0 <= c && c <= 9 ? table.digits[c] : s[i];
+	}
+	return res;
+}
+
+// A number from 1 to 9999 by place value (千二百三十四)
+function dBNumJaGroup(n, table) {
+	let res = '';
+	for (let place = 3; place >= 0; --place) {
+		let d = Math.floor(n / Math.pow(10, place)) % 10;
+		if (0 === d) {
+			continue;
+		}
+		if (place > 0 && 1 === d && !table.one) {
+			res += table.places[place];
+		} else {
+			res += table.digits[d] + table.places[place];
+		}
+	}
+	return res;
+}
+
+// A whole number, given as its digits, by place value
+function dBNumJaInteger(s, table) {
+	s = s.replace(/^0+/, '');
+	if (!s) {
+		return table.digits[0];
+	}
+	let res = '';
+	if (s.length > 16) {
+		res = dBNumJaDigits(s.slice(0, s.length - 12), table) + table.groups[3];
+		s = s.slice(s.length - 12);
+	}
+	let groups = Math.ceil(s.length / 4);
+	for (let g = groups - 1; g >= 0; --g) {
+		let end = s.length - g * 4;
+		let n = parseInt(s.slice(Math.max(0, end - 4), end), 10);
+		if (n) {
+			res += dBNumJaGroup(n, table) + table.groups[g];
+		}
+	}
+	return res;
+}
+
+// A number as General shows it with [DBNum1] to [DBNum3]: fifteen
+// significant digits, the whole part by place value and the decimals one
+// by one, never in the scientific form
+function dBNumJaGeneral(number, table, decimalSeparator) {
+	let parts = Math.abs(number).toExponential(14).split('e');
+	let digits = parts[0].replace('.', '');
+	let point = parseInt(parts[1], 10) + 1;
+	let whole, frac;
+	if (point <= 0) {
+		whole = '0';
+		frac = '0'.repeat(-point) + digits;
+	} else if (point >= digits.length) {
+		whole = digits + '0'.repeat(point - digits.length);
+		frac = '';
+	} else {
+		whole = digits.slice(0, point);
+		frac = digits.slice(point);
+	}
+	frac = frac.replace(/0+$/, '');
+	let res = dBNumJaInteger(whole, table);
+	if (frac) {
+		res += decimalSeparator + dBNumJaDigits(frac, table);
+	}
+	return res;
+}
+
+// A field of a date or time with [DBNum1] to [DBNum3]. In DBNum3 the digits
+// are only made full-width. Otherwise a year of four digits, and a field
+// that starts with a zero (05, 00), is written digit by digit, and any
+// other field by place value (十, 二十三)
+function dBNumJaField(s, table, dbNum) {
+	if (3 === dbNum || s.length > 2 || '0' === s[0]) {
+		return dBNumJaDigits(s, table);
+	}
+	return dBNumJaGroup(parseInt(s, 10), table);
+}
 const interfaceFormatScientific = '0.00E+00';
 const interfaceFormatPercent = '0.00%';
 let interfaceShortDateFormat = 'm/d/yyyy';
