From 0fa92a9537c3d72c15080e3ce53fcf00773e6e47 Mon Sep 17 00:00:00 2001
From: Yasuhiro Niji <aiseed-dev@users.noreply.github.com>
Date: Sun, 1 Nov 2026 07:15:45 +0900
Subject: [PATCH] [se] Add NUMBERSTRING, DATESTRING and PHONETIC, and show YEN
 as Excel does
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Japanese Excel has functions the editor did not know, so a workbook
that used them showed #NAME?. The answers in the tests are those of
Excel for Windows in Japanese.

NUMBERSTRING(number, type) rounds the number to a whole number and
writes it in kanji as [DBNum1] (type 1), [DBNum2] (type 2) and
[DBNum1] digits (type 3) show it; a negative number or another type is
#NUM!. DATESTRING(date) writes the date in the Japanese era as the
format gggee"年"mm"月"dd"日" shows it; a date in a string is read as
DATEVALUE reads it.

PHONETIC(reference) gives the furigana of the cells. The editor does
not keep furigana, so it gives the text of the cells as Excel does for
cells without furigana: hiragana and half-width katakana become
katakana.

YEN is the Japanese name of DOLLAR (formula-lang/ja.json); files keep
DOLLAR. In the Japanese locale it now shows whole yen by default and
the minus after the yen sign (¥1,235, ¥-1,234.57), as Excel does.
---
 .../FormulaObjects/textanddataFunctions.js    | 136 +++++++++++++++++-
 .../formula-tests/textAndDataTests.js         |  53 +++++++
 2 files changed, 187 insertions(+), 2 deletions(-)

diff --git a/cell/model/FormulaObjects/textanddataFunctions.js b/cell/model/FormulaObjects/textanddataFunctions.js
index 7e8a9d0..58ccfa5 100644
--- a/cell/model/FormulaObjects/textanddataFunctions.js
+++ b/cell/model/FormulaObjects/textanddataFunctions.js
@@ -66,9 +66,11 @@ function (window, undefined) {
 		cEXACT, cFIND, cFINDB, cFIXED, cIMPORTRANGE, cJIS, cLEFT, cLEFTB, cLEN, cLENB, cLOWER, cMID, cMIDB, cNUMBERVALUE, cPHONETIC,
 		cPROPER, cREPLACE, cREPLACEB, cREPT, cRIGHT, cRIGHTB, cREGEXTEST, cREGEXEXTRACT, cREGEXREPLACE, cSEARCH, cSEARCHB, cSUBSTITUTE, cT, cTEXT, cTEXTJOIN,
 		cTRIM, cUNICHAR, cUNICODE, cUPPER, cVALUE, cTEXTBEFORE, cTEXTAFTER, cTEXTSPLIT);
+	// The functions of Japanese Excel
+	cFormulaFunctionGroup['TextAndData'].push(cDATESTRING, cNUMBERSTRING);
 
 	cFormulaFunctionGroup['NotRealised'] = cFormulaFunctionGroup['NotRealised'] || [];
-	cFormulaFunctionGroup['NotRealised'].push(cBAHTTEXT, cPHONETIC);
+	cFormulaFunctionGroup['NotRealised'].push(cBAHTTEXT);
 
 	const MAX_UNSIGNED_INT_16 = 65535;
 
@@ -917,7 +919,10 @@ function (window, undefined) {
 			return "" + _tmp + (res.length === 2 ? "." + _dec + "" : "");
 		}
 
-		let arg0 = arg[0], arg1 = arg[1] ? arg[1] : new cNumber(2), arg2 = arg[2] ? arg[2] : new cBool(false);
+		// In Japanese (YEN), whole yen by default and the minus after the yen
+		// sign (¥-1,235), as in Excel
+		let bJa = 0x411 === (window["Asc"]["editor"] && window["Asc"]["editor"].asc_getLocale());
+		let arg0 = arg[0], arg1 = arg[1] ? arg[1] : new cNumber(bJa ? 0 : 2), arg2 = arg[2] ? arg[2] : new cBool(false);
 
 		if (arg0 instanceof cArea || arg0 instanceof cArea3D) {
 			arg0 = arg0.cross(arguments[1]);
@@ -1031,6 +1036,9 @@ function (window, undefined) {
 			let arr = api.asc_getFormatCells(info);
 			format = arr && arr[2];
 		}
+		if (bJa) {
+			format = '"¥"#,##0' + cNull + ';"¥"-#,##0' + cNull;
+		}
 		if (!format) {
 			format = "$#,##0" + cNull + ";($#,##0" + cNull + ")";
 		}
@@ -4065,6 +4073,130 @@ function (window, undefined) {
 		return res && res.isValidArray() ? res : new cError(cErrorType.not_available);
 	};
 
+	// The functions of Japanese Excel
+
+	// PHONETIC(reference): the furigana of the cells
+	cPHONETIC.prototype.argumentsMin = 1;
+	cPHONETIC.prototype.argumentsMax = 1;
+	cPHONETIC.prototype.arrayIndexes = {0: 1};
+	cPHONETIC.prototype.argumentsType = [argType.reference];
+	// The editor does not keep furigana, so this is the text of the cells as
+	// Excel gives it for cells without furigana: hiragana and half-width
+	// katakana become katakana (かなｶﾅ is カナカナ); half-width ｡｢｣､･ stay
+	function toKatakana(str) {
+		return str.replace(/[\uFF66-\uFF9F]+/g, toFullWidth)
+			.replace(/[\u3041-\u3093]/g, function (ch) { return String.fromCharCode(ch.charCodeAt(0) + 0x60); });
+	}
+	cPHONETIC.prototype.Calculate = function (arg) {
+		let arg0 = arg[0];
+		if (arg0 instanceof cArea || arg0 instanceof cArea3D) {
+			let res = '', values = arg0.getValue();
+			for (let i = 0; i < values.length; i++) {
+				if (values[i] instanceof cError) {
+					return values[i];
+				}
+				if (values[i] instanceof cString) {
+					res += toKatakana(values[i].getValue());
+				}
+			}
+			return new cString(res);
+		}
+		if (arg0 instanceof cRef || arg0 instanceof cRef3D) {
+			arg0 = arg0.getValue();
+		}
+		if (arg0 instanceof cArray) {
+			arg0 = arg0.getElementRowCol(0, 0);
+		}
+		if (arg0 instanceof cError) {
+			return arg0;
+		}
+		return new cString(arg0 instanceof cString ? toKatakana(arg0.getValue()) : '');
+	};
+
+	// A number or date as a format of the ja-JP locale shows it
+	function formatJa(format, number) {
+		return oNumFormatCache.get(format).format(number, CellValueType.Number, AscCommon.gc_nMaxDigCount)
+			.map(function (part) { return part.text; }).join('');
+	}
+
+	// The value of one argument as a cNumber or cError: a date in a string is
+	// its serial number, as in DATEVALUE
+	function toNumberJa(arg, cell, bDate) {
+		if (arg instanceof cArea || arg instanceof cArea3D) {
+			arg = arg.cross(cell);
+		} else if (arg instanceof cArray) {
+			arg = arg.getElementRowCol(0, 0);
+		}
+		if (arg instanceof cRef || arg instanceof cRef3D) {
+			arg = arg.getValue();
+		}
+		if (bDate && arg instanceof cString) {
+			let res = g_oFormatParser.parse(arg.getValue());
+			return res ? new cNumber(res.value) : new cError(cErrorType.wrong_value_type);
+		}
+		return arg.tocNumber();
+	}
+
+	/**
+	 * DATESTRING(date) of Japanese Excel: the date in the Japanese era
+	 * @constructor
+	 * @extends {AscCommonExcel.cBaseFunction}
+	 */
+	function cDATESTRING() {
+	}
+
+	cDATESTRING.prototype = Object.create(cBaseFunction.prototype);
+	cDATESTRING.prototype.constructor = cDATESTRING;
+	cDATESTRING.prototype.name = 'DATESTRING';
+	cDATESTRING.prototype.argumentsMin = 1;
+	cDATESTRING.prototype.argumentsMax = 1;
+	cDATESTRING.prototype.numFormat = AscCommonExcel.cNumFormatNone;
+	cDATESTRING.prototype.argumentsType = [argType.any];
+	cDATESTRING.prototype.Calculate = function (arg) {
+		let date = toNumberJa(arg[0], arguments[1], true);
+		if (date instanceof cError) {
+			return date;
+		}
+		if (date.getValue() < 0) {
+			return new cError(cErrorType.wrong_value_type);
+		}
+		return new cString(formatJa('[$-411]gggee"年"mm"月"dd"日"', Math.floor(date.getValue())));
+	};
+
+	// The formats of the types 1 to 3 of NUMBERSTRING
+	const NUMBERSTRING_FORMATS = ['[DBNum1][$-411]General', '[DBNum2][$-411]General', '[DBNum1][$-411]0'];
+
+	/**
+	 * NUMBERSTRING(number, type) of Japanese Excel: the number rounded to a
+	 * whole number in kanji; #NUM! for a negative number or another type
+	 * @constructor
+	 * @extends {AscCommonExcel.cBaseFunction}
+	 */
+	function cNUMBERSTRING() {
+	}
+
+	cNUMBERSTRING.prototype = Object.create(cBaseFunction.prototype);
+	cNUMBERSTRING.prototype.constructor = cNUMBERSTRING;
+	cNUMBERSTRING.prototype.name = 'NUMBERSTRING';
+	cNUMBERSTRING.prototype.argumentsMin = 2;
+	cNUMBERSTRING.prototype.argumentsMax = 2;
+	cNUMBERSTRING.prototype.numFormat = AscCommonExcel.cNumFormatNone;
+	cNUMBERSTRING.prototype.argumentsType = [argType.number, argType.number];
+	cNUMBERSTRING.prototype.Calculate = function (arg) {
+		let number = toNumberJa(arg[0], arguments[1]), type = toNumberJa(arg[1], arguments[1]);
+		if (number instanceof cError) {
+			return number;
+		}
+		if (type instanceof cError) {
+			return type;
+		}
+		let format = NUMBERSTRING_FORMATS[Math.floor(type.getValue()) - 1];
+		if (!format || number.getValue() < 0) {
+			return new cError(cErrorType.not_numeric);
+		}
+		return new cString(formatJa(format, Math.round(number.getValue())));
+	};
+
 	//----------------------------------------------------------export----------------------------------------------------
 	window['AscCommonExcel'] = window['AscCommonExcel'] || {};
 	window['AscCommonExcel'].cTEXT = cTEXT;
diff --git a/tests/cell/spreadsheet-calculation/formula-tests/textAndDataTests.js b/tests/cell/spreadsheet-calculation/formula-tests/textAndDataTests.js
index 383b8ce..5d05206 100644
--- a/tests/cell/spreadsheet-calculation/formula-tests/textAndDataTests.js
+++ b/tests/cell/spreadsheet-calculation/formula-tests/textAndDataTests.js
@@ -1180,6 +1180,59 @@ $(function () {
 		}
 	});
 
+	QUnit.test("Test: Japanese NUMBERSTRING, DATESTRING, PHONETIC and DOLLAR (YEN)", function (assert) {
+		// The answers are those of Excel for Windows in Japanese
+		ws.getRange2("Z500").setValue("漢字");
+		ws.getRange2("Z501").setValue("123");
+		ws.getRange2("Z502").setValue("かな");
+		ws.getRange2("Z503").setValue("ABCあいうｱｲｳabc１２");
+		ws.getRange2("Z504").setValue("がぱゐゑゔ・ー");
+		ws.getRange2("Z505").setValue("ｶﾞﾊﾟ｡｢｣ﾞ");
+		window["Asc"]["editor"].asc_setLocale(1041);
+		let cases = [
+			['NUMBERSTRING(123456789,1)', '一億二千三百四十五万六千七百八十九'],
+			['NUMBERSTRING(123456789,2)', '壱億弐阡参百四拾伍萬六阡七百八拾九'],
+			['NUMBERSTRING(123456789,3)', '一二三四五六七八九'],
+			['NUMBERSTRING(1050,1)', '千五十'],
+			['NUMBERSTRING(100000,2)', '壱拾萬'],
+			['NUMBERSTRING(1001,3)', '一〇〇一'],
+			['NUMBERSTRING(2.5,1)', '三'],
+			['NUMBERSTRING(1234.5,3)', '一二三五'],
+			['NUMBERSTRING(0,1)', '〇'],
+			['NUMBERSTRING(0,2)', '〇'],
+			['NUMBERSTRING(12,1.9)', '十二'],
+			['NUMBERSTRING("12",1)', '十二'],
+			['NUMBERSTRING(1,4)', '#NUM!'],
+			['NUMBERSTRING(1,0)', '#NUM!'],
+			['NUMBERSTRING(-5,1)', '#NUM!'],
+			['NUMBERSTRING(-0.4,1)', '#NUM!'],
+			['DATESTRING(46301)', '令和08年10月06日'],
+			['DATESTRING(46301.75)', '令和08年10月06日'],
+			['DATESTRING("2019/4/30")', '平成31年04月30日'],
+			['DATESTRING("2019/5/1")', '令和01年05月01日'],
+			['DATESTRING(1)', '明治33年01月01日'],
+			['DATESTRING("abc")', '#VALUE!'],
+			['DATESTRING(-1)', '#VALUE!'],
+			['DOLLAR(1234.567)', '¥1,235'],
+			['DOLLAR(1234.567,2)', '¥1,234.57'],
+			['DOLLAR(1234.567,-2)', '¥1,200'],
+			['DOLLAR(-1234.567,2)', '¥-1,234.57'],
+			['PHONETIC(Z500)', '漢字'],
+			['PHONETIC(Z501)', ''],
+			['PHONETIC(Z502)', 'カナ'],
+			['PHONETIC(Z503)', 'ABCアイウアイウabc１２'],
+			['PHONETIC(Z504)', 'ガパヰヱゔ・ー'],
+			['PHONETIC(Z505)', 'ガパ｡｢｣゛'],
+			['PHONETIC(Z500:Z502)', '漢字カナ'],
+		];
+		for (let i = 0; i < cases.length; i++) {
+			oParser = new parserFormula(cases[i][0], 'A2', ws);
+			assert.ok(oParser.parse(), 'Test: Formula ' + cases[i][0] + ' is parsed.');
+			assert.strictEqual(oParser.calculate().getValue(), cases[i][1], 'Test: ' + cases[i][0]);
+		}
+		window["Asc"]["editor"].asc_setLocale(1033);
+	});
+
 	QUnit.test("Test: \"CHAR\"", function (assert) {
 		// Data for reference link. Use A100-A111
 		ws.getRange2("A100").setValue("65");
-- 
